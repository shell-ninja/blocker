# ── Build artifacts ────────────────────────────────────────────────────────────
# Generated by `make`, `make dev`, `make static`, `make check`
build/
gen/

# ── C / C++ ────────────────────────────────────────────────────────────────────
*.o
*.a
*.so
*.so.*
*.d
*.dSYM/

# ── Editors & IDEs ─────────────────────────────────────────────────────────────
# VS Code
.vscode/

# JetBrains (CLion, etc.)
.idea/
cmake-build-*/
*.iml

# Vim / Neovim
*.swp
*.swo
*~
Session.vim

# Emacs
\#*\#
.\#*

# ── OS metadata ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Local runtime / installed state ────────────────────────────────────────────
# These live in /etc/blocker and /var/lib/blocker at runtime — never in the repo
*.conf.local
*.log

# ── Secrets / sensitive files ──────────────────────────────────────────────────
# The auth file (password hash) should never be committed
auth
*.key
*.pem

# ── Python test artefacts ──────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── Misc ───────────────────────────────────────────────────────────────────────
*.bak
*.orig
*.tmp
*.dat
cache.dat
*list*.txt
*sites*.txt
