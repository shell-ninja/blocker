{
  "name": "Blocker Web Shield",
  "version": "1.3",
  "manifest_version": 3,
  "description": "Blocker In-Page UI and Keyword Shield for Instagram and Reddit",
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://instagram.com/*",
        "*://*.reddit.com/*",
        "*://reddit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://reddit.com/*"
      ],
      "js": ["reddit_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
